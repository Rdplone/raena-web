# Sitenin canlı adresi (canonical, sitemap ve Open Graph için kullanılır)
NEXT_PUBLIC_SITE_URL=https://raena.agency

# --- İletişim formu SMTP ayarları (Gmail) ---
# Vercel > Project > Settings > Environment Variables altına aynı değerleri girin.
# SMTP_PASS normal Gmail şifresi DEĞİLDİR: Google Hesabı > Güvenlik > 2 Adımlı Doğrulama açıkken
# "Uygulama şifreleri" bölümünden oluşturulan 16 haneli şifredir (boşluksuz yazın).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=raenaplus@gmail.com
SMTP_PASS=buraya-16-haneli-uygulama-sifresi

# Gmail, gönderen adresin SMTP_USER ile aynı olmasını ister
CONTACT_FROM_EMAIL="RAENA Web Sitesi <raenaplus@gmail.com>"
# Başvuruların düşeceği adres(ler) — virgülle birden fazla yazılabilir
CONTACT_TO_EMAIL=raenaplus@gmail.com
# Form dolduran kişiye otomatik teşekkür e-postası gönderilsin mi?
CONTACT_SEND_AUTOREPLY=true
