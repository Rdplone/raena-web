# Sitenin canlı adresi (canonical, sitemap ve Open Graph için kullanılır)
NEXT_PUBLIC_SITE_URL=https://raena.agency

# --- İletişim formu SMTP ayarları (Vercel > Project > Settings > Environment Variables) ---
# Örnekler: Google Workspace -> smtp.gmail.com:465 (uygulama şifresi gerekir)
#           Yandex -> smtp.yandex.com.tr:465 | Microsoft 365 -> smtp.office365.com:587
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# 465 için true, 587 (STARTTLS) için false
SMTP_SECURE=true
SMTP_USER=bildirim@raena.agency
SMTP_PASS=degistir-beni

# Formun gönderen adresi (genelde SMTP_USER ile aynı olmalı)
CONTACT_FROM_EMAIL="RAENA Web <bildirim@raena.agency>"
# Başvuruların düşeceği adres(ler) — virgülle birden fazla yazılabilir
CONTACT_TO_EMAIL=info@raena.agency
# Form dolduran kişiye otomatik teşekkür e-postası gönderilsin mi?
CONTACT_SEND_AUTOREPLY=true
